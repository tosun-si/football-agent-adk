export GCP_PROJECT_ID=gb-poc-373711
export BIGQUERY_DATASET=qatar_fifa_world_cup
export BIGQUERY_TABLE=team_players_stat_raw
export GOOGLE_GENAI_USE_VERTEXAI=True
export LOCATION=europe-west1

# Webapp backend URLs (used by Next.js API routes via process.env)
export CLOUD_RUN_API_URL=https://football-stats-api-4wtmsxga6q-ew.a.run.app
export AGENT_ENGINE_PROXY_URL=https://agent-engine-proxy-975119474255.europe-west1.run.app

# Create venv if it doesn't exist (optional in .envrc but good for bootstrap)
if [ ! -d ".venv" ]; then
    uv venv
fi

# Activate venv
source .venv/bin/activate
